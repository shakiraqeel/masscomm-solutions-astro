---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import '../styles/global.css';

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const page = (path = '') => `${base}${path}`;
const formEndpoint = 'https://formsubmit.co/Info@masscommsolutions.pk';
const thankYouUrl = new URL(page('thanks/'), Astro.site).href;

const imageModules = import.meta.glob<{ default: ImageMetadata }>('../assets/*', { eager: true });
const image = (file: string) => {
  const asset = imageModules[`../assets/${file}`];
  if (!asset) throw new Error(`Missing image asset: ${file}`);
  return asset.default;
};

const projects = [
  { image: 'card.webp', date: '1 / March / 2025', title: 'Prime Minister House', large: true },
  { image: 'card1.webp', date: '1 / March / 2025', title: 'HRPN Event in PC Hotel' },
  { image: 'card3.webp', date: '27 / June / 2025', title: 'GAIN at Marriott Hotel' }
];

const services = [
  ['Event Management', 'At MassComm, we believe every event should tell your story. Our event planning services are designed to take the stress off your plate while turning your vision into a fully immersive experience. From concept creation to seamless execution, our team handles everything with care. As professional event decorators, we’re known for delivering stunning event design in Islamabad, tailored setups, thoughtful branding, and an atmosphere your guests won’t forget.'],
  ['Fabrication', 'From branded exhibition stalls and stage structures to custom kiosks, our fabrication team creates strong, polished builds designed around your event and brand.'],
  ['Audio Visual', 'Professional sound, lighting, screens, projection and technical support ensure your message is seen and heard clearly throughout the venue.'],
  ['Food & Catering', 'Thoughtfully planned menus, professional service and seamless coordination create a dining experience that complements every occasion.'],
  ['Design & Production', 'Our creative team develops visual identities, print collateral, digital content and complete production systems for a consistent event experience.']
];

const expertise = [
  ['Cards3-1-2.png', 'Product Launches & Activations'],
  ['Cards3-1-1-1.png', 'Corporate Conferences & Seminars'],
  ['Cards3-1-5.png', 'Trade Expos & Exhibitions'],
  ['Cards3-1-3-1.png', 'Workshops & Training Events'],
  ['Cards3-1-2-1-1.png', 'Networking Events & Social Mixers']
];

const rentals = [
  ['one.png', 'SMD Screens & Panels', 'High-resolution screens for impactful visual presentations at any scale.'],
  ['two.png', 'Exhibition Stalls & Kiosks', 'Custom-designed setups that enhance brand presence and audience engagement.'],
  ['three.png', 'Complete Audio Visual Packages', 'End-to-end AV solutions including sound, lighting, and display systems.'],
  ['four.png', 'Custom Fabrication', 'Tailor-made structures built to match your event’s unique vision and needs.']
];

const clients = [
  ['Becanhouse-school.png', 'BSS'], ['Bahria-University.png', 'Bahria University'], ['Altas-Honda.png', 'Atlas Honda'],
  ['B-p.png', 'Bosch Pharma'], ['CDA.png', 'CDA'], ['Vector-Smart-Object-02.png', 'PIDE'],
  ['Vector-Smart-Object-01.png', 'Defense'], ['akj5pd8c3evspfmyvgda.png', 'WWF'], ['hy0ld8ytxiwh9y1cq9tf.png', 'Embassy'],
  ['jh0bza8spj9aq9b7rzp4.png', 'Calyx'], ['mief5lx8tz6kp8pmct2j.png', 'Bangladesh Government'], ['rjguayrl6ffg1aifvx17.png', 'HEC'],
  ['syfh4kaygogplwzfs4ry.png', 'PIMA'], ['tevlomkedyidndc8qus1.png', 'Riphah'], ['wq9ghlat3do73gjglfhx.png', 'NHA'],
  ['jvneafbdrsdoy9xwvj6z.png', 'NDMA'], ['xhyozx2lcnymuam53tor.png', 'Partner'], ['ps2anoa3jnyxliqj12is.png', 'Partner']
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="MassComm Solutions — corporate event management, fabrication, audiovisual, catering and production in Pakistan." />
    <style is:inline set:html={`@font-face{font-family:Glancyr;src:url('${page('fonts/Glancyr-Light.ttf')}') format('truetype');font-weight:300;font-display:swap}@font-face{font-family:Glancyr;src:url('${page('fonts/Glancyr-SemiBold.ttf')}') format('truetype');font-weight:600 900;font-display:swap}`} />
    <title>MassComm Solutions</title>
  </head>
  <body>
    <header class="site-header">
      <div class="container nav-wrap">
        <a href={base} class="brand" aria-label="MassComm Solutions home">
          <Image src={image('logo.png')} alt="MassComm Solutions" width={190} format="webp" />
        </a>
        <nav class="contact-nav" aria-label="Contact links">
          <a href="tel:03456300725">
            <svg class="ui-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.8 19.8 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.12 4.18 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.69 2.8a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.28-1.28a2 2 0 0 1 2.11-.45c.9.33 1.84.56 2.8.69A2 2 0 0 1 22 16.92Z" /></svg>
            0345 6300725
          </a>
          <a href="mailto:Info@masscommsolutions.pk">
            <svg class="ui-icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 7 9 6 9-6" /></svg>
            Info@masscommsolutions.pk
          </a>
        </nav>
        <nav class="main-nav" aria-label="Main navigation">
          <a class="active" href={base}>Home</a>
          <button class="links-button" type="button" aria-expanded="false" aria-controls="main-dropdown">
            Links
            <svg class="chevron" viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
          </button>
          <div id="main-dropdown" class="dropdown">
            <a href="#services">Services</a>
            <a href="#expertise">Expertise</a>
            <a href="#contact-form">Contact</a>
          </div>
        </nav>
        <button class="menu-button" type="button" aria-label="Open navigation" aria-expanded="false" aria-controls="main-navigation">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16" /></svg>
        </button>
      </div>
    </header>

    <main id="top">
      <section class="hero">
        <Image src={image('banner.webp')} alt="" class="hero-image" width={1970} loading="eager" fetchpriority="high" />
        <div class="hero-shade"></div>
        <div class="container hero-grid">
          <div class="hero-copy">
            <h1>Leading Corporate</h1>
            <h2>Event Management<br />Company</h2>
            <p>We go beyond logistics; we design experiences. Whether it is a corporate gala, seminar, or product launch, Mass Comm Solutions delivers creativity, precision, and professionalism that make your event unforgettable.</p>
            <div class="hero-actions">
              <a class="button button-primary" href="#contact-form">
                <svg class="arrow-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" /></svg>
                Let’s Plan Your Event
              </a>
              <a class="phone-link" href="tel:03456300725">
                <svg class="ui-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.8 19.8 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.12 4.18 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.69 2.8a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.28-1.28a2 2 0 0 1 2.11-.45c.9.33 1.84.56 2.8.69A2 2 0 0 1 22 16.92Z" /></svg>
                <strong>0345 6300725</strong>
              </a>
            </div>
          </div>
          <form class="quick-form" action={formEndpoint} method="POST">
            <input type="hidden" name="_subject" value="New quick event enquiry" />
            <input type="hidden" name="_next" value={thankYouUrl} />
            <input type="hidden" name="_template" value="table" />
            <input class="form-honey" type="text" name="_honey" tabindex="-1" autocomplete="off" />
            <label><span class="sr-only">Name</span><input required name="name" autocomplete="name" placeholder="Name" /></label>
            <label><span class="sr-only">Company Name</span><input required name="companyName" autocomplete="organization" placeholder="Company Name" /></label>
            <label class="input-with-icon">
              <span class="sr-only">Phone Number</span>
              <svg class="field-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.8 19.8 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.12 4.18 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72" /></svg>
              <input required name="phoneNumber" type="tel" autocomplete="tel" placeholder="Phone Number" />
            </label>
            <label><span class="sr-only">Email Address</span><input required name="email" type="email" autocomplete="email" placeholder="Email Address" /></label>
            <label class="full"><span class="sr-only">City</span><input required name="city" autocomplete="address-level2" placeholder="City" /></label>
            <button class="button button-primary" type="submit">Send</button>
          </form>
        </div>
      </section>

      <section class="about section-white">
        <div class="container">
          <div class="about-intro">
            <Image class="about-logo" src={image('logoC.png')} alt="Mass Comm Solutions" width={440} format="webp" />
            <div class="about-copy">
              <p>Mass Comm Solutions is a full-service event management company specializing in planning, designing, and executing events that leave lasting impressions. From high-profile conferences to vibrant expos, our team delivers end-to-end solutions tailored to your goals.</p>
              <p>We combine creativity with technical precision to ensure every detail—from venue layout to audiovisual setup—enhances the overall experience.</p>
            </div>
          </div>
          <div class="project-grid">
            {projects.map((project) => (
              <article class:list={['project-card', { large: project.large }]}>
                <Image src={image(project.image)} alt={project.title} class="project-image" width={project.large ? 640 : 340} format="webp" />
                <div class="project-overlay"></div>
                <div class="project-meta"><small>{project.date}</small><h3>{project.title}</h3></div>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="stats-section">
        <div class="container stats-grid">
          <article><strong data-count="35" data-suffix="+">0+</strong><p>Cities Where We Have Successfully Executed Events</p></article>
          <article><strong data-count="15" data-suffix="+">0+</strong><p>Years experience of event management sector</p></article>
          <article><strong data-count="200" data-suffix="+">0+</strong><p>Direct and indirect employees working on our projects</p></article>
          <article><strong data-count="2" data-suffix="B">0B</strong><p>Total project value of all time</p></article>
        </div>
      </section>

      <section id="services" class="services section-white">
        <div class="container services-layout">
          <aside class="services-intro">
            <h2 class="section-title">Our Services</h2>
            <p class="section-lead left">Whatever the scale or style of your event, Mass Comm Solutions delivers with precision and creativity. Our integrated services ensure a smooth, hassle-free experience—all under one roof.</p>
          </aside>
          <div class="accordion">
            {services.map(([title, copy], index) => {
              const panelId = `service-panel-${index}`;
              return (
                <article class:list={['accordion-item', { open: index === 0 }]}>
                  <button type="button" aria-expanded={index === 0 ? 'true' : 'false'} aria-controls={panelId}>
                    <span>{title}</span><b aria-hidden="true">{index === 0 ? '×' : '+'}</b>
                  </button>
                  <div id={panelId} class="accordion-panel"><p>{copy}</p></div>
                </article>
              );
            })}
          </div>
        </div>
      </section>

      <section id="expertise" class="expertise">
        <div class="container">
          <h2 class="section-title center">Our Expertise</h2>
          <p class="section-lead">With years of experience and a versatile portfolio, we bring strategic insight and creative execution to every event type. Whether it is a formal conference or a dynamic product launch, our team ensures each event delivers maximum impact.</p>
          <div class="expertise-grid">
            {expertise.map(([file, title]) => (
              <article class="expertise-card">
                <Image src={image(file)} alt={title} width={360} format="webp" />
                <div></div><p>{title}</p>
              </article>
            ))}
          </div>
          <div class="center-action"><a href="#contact-form" class="button button-primary"><svg class="arrow-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" /></svg>Let us plan your next big moment!</a></div>
        </div>
      </section>

      <section class="rentals section-white">
        <div class="container">
          <h2 class="section-title center">Rental <em>Solutions</em> for Corporate Events</h2>
          <p class="section-lead">We offer a wide range of high-performance equipment and structures to support your event needs—delivered, installed, and managed by professionals.</p>
          <div class="rental-grid">
            {rentals.map(([file, title, copy]) => (
              <article><Image src={image(file)} alt="" width={145} format="webp" /><h3>{title}</h3><p>{copy}</p></article>
            ))}
          </div>
          <div class="center-action"><a class="outline-button" href="tel:03456300725"><span><svg class="arrow-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" /></svg></span>Call Now</a></div>
        </div>
      </section>

      <section class="clients">
        <div class="container">
          <h2 class="section-title center">Our <em>Valued</em> Clients</h2>
          <p class="section-lead">We have had the privilege of working with industry-leading brands across diverse sectors, delivering events that exceed expectations.</p>
          <div class="client-grid" role="list" aria-label="Client logos">
            {clients.map(([file, alt]) => {
              const clientImage = image(file);
              return <div class="client-logo" role="listitem"><Image src={clientImage} alt={alt} width={Math.min(clientImage.width, 300)} format="webp" quality={80} /></div>;
            })}
          </div>
        </div>
      </section>

      <section class="story section-white">
        <div class="container">
          <h2><em>Event Organizers in Pakistan:</em><br />MassComm Solutions at Your Service</h2>
          <div class="story-more" hidden><p>From strategy and creative direction to production and on-site management, our experienced team provides dependable support for corporate events throughout Pakistan.</p></div>
          <button class="button button-primary read-more" type="button">Read More</button>
        </div>
      </section>

      <section class="contact-section">
        <div class="container contact-layout">
          <div class="map-wrap"><iframe title="MassComm Solutions location" loading="lazy" src="https://www.google.com/maps?q=Gulberg%20Empire%2C%20Gulberg%20Greens%2C%20Islamabad&output=embed"></iframe></div>
          <form id="contact-form" class="contact-form" action={formEndpoint} method="POST">
            <input type="hidden" name="_subject" value="New detailed event enquiry" />
            <input type="hidden" name="_next" value={thankYouUrl} />
            <input type="hidden" name="_template" value="table" />
            <input class="form-honey" type="text" name="_honey" tabindex="-1" autocomplete="off" />
            <h2>Start Your <em>Event Journey</em></h2>
            <p>Share your event details and our team will reach out with tailored ideas and a swift response.</p>
            <div class="form-grid">
              <label>Name<input required name="name" autocomplete="name" placeholder="Name" /></label>
              <label>Company Name<input name="company" autocomplete="organization" placeholder="Company Name" /></label>
              <label>Phone<input required name="phone" type="tel" autocomplete="tel" placeholder="Phone" /></label>
              <label>Email<input required name="email" type="email" autocomplete="email" placeholder="Email" /></label>
              <label>City<input required name="city" autocomplete="address-level2" placeholder="City" /></label>
              <label>Event Date<input required name="eventDate" type="date" /></label>
              <label class="full">Type your message here<textarea name="message" placeholder="Type your message here"></textarea></label>
            </div>
            <button class="button button-primary" type="submit">Submit</button>
          </form>
        </div>
      </section>
    </main>

    <footer>
      <div class="container footer-grid">
        <div>
          <p class="footer-label">Call us</p>
          <a class="footer-call" href="tel:03456300725"><svg class="ui-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.8 19.8 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.12 4.18 2 2 0 0 1 4.11 2h3" /></svg><span>0345 6300725</span></a>
          <p class="footer-label address-label">Office Address:</p>
          <p>Office 308 Third Floor<br />Gulberg Empire, Gulberg<br />Greens, Islamabad</p>
        </div>
        <nav aria-label="Footer navigation">
          <a href={page('about/')}>About Us</a>
          <a href={page('privacy-policy/')}>Privacy Policy</a>
          <a href={page('contact/')}>Contact Us</a>
          <a href={page('terms/')}>Terms &amp; Conditions</a>
        </nav>
        <div class="footer-bottom"><small>All Rights Reserved © 2026</small><Image src={image('logo.png')} alt="MassComm Solutions" width={205} format="webp" /></div>
      </div>
    </footer>
    <a class="whatsapp" href="https://wa.me/923456300725" target="_blank" rel="noreferrer" aria-label="Chat on WhatsApp">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.52 3.48A11.82 11.82 0 0 0 12.08 0C5.5 0 .15 5.35.15 11.93c0 2.1.55 4.16 1.6 5.97L.05 24l6.24-1.64a11.9 11.9 0 0 0 5.79 1.48h.01C18.67 23.84 24 18.49 24 11.91c0-3.18-1.24-6.17-3.48-8.43Zm-8.44 18.35h-.01a9.9 9.9 0 0 1-5.05-1.38l-.36-.21-3.7.98.99-3.61-.24-.37a9.86 9.86 0 0 1-1.52-5.31c0-5.47 4.45-9.92 9.93-9.92a9.87 9.87 0 0 1 7.02 2.91 9.87 9.87 0 0 1 2.9 7.03c-.01 5.47-4.46 9.92-9.94 9.92Zm5.44-7.43c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.64.07-.3-.15-1.26-.46-2.4-1.48a9 9 0 0 1-1.66-2.06c-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.61-.91-2.2-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.48s1.07 2.88 1.21 3.08c.15.2 2.1 3.21 5.09 4.5.71.3 1.27.49 1.7.63.72.23 1.37.2 1.88.12.57-.08 1.76-.72 2.01-1.42.25-.7.25-1.3.17-1.42-.07-.13-.27-.2-.57-.35Z" /></svg>
    </a>

    <script>
      const menuButton = document.querySelector('.menu-button');
      const nav = document.querySelector('.main-nav');
      menuButton?.addEventListener('click', () => {
        const open = nav?.classList.toggle('mobile-open') || false;
        menuButton.setAttribute('aria-expanded', String(open));
        menuButton.setAttribute('aria-label', open ? 'Close navigation' : 'Open navigation');
      });

      const linksButton = document.querySelector('.links-button');
      linksButton?.addEventListener('click', () => {
        const open = linksButton.getAttribute('aria-expanded') !== 'true';
        linksButton.setAttribute('aria-expanded', String(open));
        document.querySelector('.dropdown')?.classList.toggle('show', open);
      });

      document.querySelectorAll('.dropdown a').forEach((link) => link.addEventListener('click', () => {
        nav?.classList.remove('mobile-open');
        menuButton?.setAttribute('aria-expanded', 'false');
        menuButton?.setAttribute('aria-label', 'Open navigation');
      }));

      document.querySelectorAll('.accordion-item button').forEach((button) => {
        button.addEventListener('click', () => {
          const item = button.closest('.accordion-item');
          const open = !item?.classList.contains('open');
          document.querySelectorAll('.accordion-item').forEach((entry) => {
            entry.classList.remove('open');
            entry.querySelector('button')?.setAttribute('aria-expanded', 'false');
            const sign = entry.querySelector('b'); if (sign) sign.textContent = '+';
          });
          if (open && item) {
            item.classList.add('open');
            button.setAttribute('aria-expanded', 'true');
            const sign = button.querySelector('b'); if (sign) sign.textContent = '×';
          }
        });
      });

      const observer = new IntersectionObserver((entries) => entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        const node = entry.target;
        const end = Number(node.dataset.count || 0); const suffix = node.dataset.suffix || '';
        let start = 0; const step = Math.max(1, Math.ceil(end / 40));
        const timer = window.setInterval(() => {
          start = Math.min(end, start + step); node.textContent = `${start}${suffix}`;
          if (start >= end) clearInterval(timer);
        }, 28);
        observer.unobserve(node);
      }), { threshold: .5 });
      document.querySelectorAll('[data-count]').forEach((node) => observer.observe(node));

      document.querySelector('.read-more')?.addEventListener('click', (event) => {
        const panel = document.querySelector('.story-more'); if (!panel) return;
        panel.hidden = !panel.hidden;
        event.currentTarget.textContent = panel.hidden ? 'Read More' : 'Read Less';
      });
    </script>
  </body>
</html>
